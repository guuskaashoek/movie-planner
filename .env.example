# Copy to .env.local for local development and fill in the values.

# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# Google OAuth (callback: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Wasabi (S3-compatible) storage for posters and tickets
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_BUCKET_NAME=
WASABI_REGION=eu-central-1
# Optional overrides
# WASABI_ENDPOINT=https://s3.eu-central-1.wasabisys.com
# WASABI_PUBLIC_BASE=https://s3.eu-central-1.wasabisys.com/your-bucket

# Comma-separated emails that are always admins (bootstraps the first admin)
ADMIN_EMAILS=

# Optional: comma-separated emails. When all of them are going to a screening,
# their calendar feed gets a "don't forget the grapes" reminder 30 minutes before.
# Leave empty to disable.
GRAPE_REMINDER_EMAILS=
